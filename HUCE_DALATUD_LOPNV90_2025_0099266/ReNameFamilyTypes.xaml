<Window x:Class="HUCE_DALATUD_LOPNV90_2025_0099266.ReNameFamilyTypes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUCE_DALATUD_LOPNV90_2025_0099266"
        mc:Ignorable="d"
        Title="ProRename Tool - Rename Family Types" Height="450" Width="800"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Style cho Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Style cho TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="100"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="10">
            <TextBlock Text="Rename Family Types" FontSize="16" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <ComboBox Width="200" ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" 
               ToolTip="Select a category to filter"/>
                <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
              ToolTip="Enter text to filter type names"/>
                <Button Content="Filter" Command="{Binding FilterCommand}"/>
                <Button Content="SHOW ALL" Command="{Binding ShowAllCommand}"/>
            </StackPanel>
        </StackPanel>
        <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FamilyTypes}" 
      AutoGenerateColumns="False" Margin="10,10,10,10" CanUserResizeColumns="True" 
      EnableRowVirtualization="True" VirtualizingStackPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="50" Header="Select"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName}" Width="200"/>
                <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}" Width="200"/>
                <DataGridTextColumn Header="New Type Name Preview" Binding="{Binding NewTypeName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Rename Rules" Margin="10">
            <StackPanel Orientation="Vertical">
                <!-- Prefix -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Remove First:" Width="100"/>
                    <TextBox Text="{Binding RemoveFirst, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                    <TextBlock Text="Add Prefix:" Width="100" Margin="10,0,0,0"/>
                    <TextBox Text="{Binding AddPrefix, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </StackPanel>
            </StackPanel>

        </GroupBox>
    </Grid>
    
</Window>
