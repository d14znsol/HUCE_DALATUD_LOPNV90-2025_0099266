<Window x:Class="HUCE_DALATUD_LOPNV90_2025_0099266.Views.MAINWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HUCE_DALATUD_LOPNV90_2025_0099266"
        Title="Prorename Tool" Height="400" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent">
    <Border CornerRadius="20"   Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <TextBlock Grid.Row="0" Text="ProRename Tool" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0 0 0 20" Foreground="#0078D4"/>

            <!-- Các button sử dụng MVVM Command -->
            <UniformGrid Grid.Row="1" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Rename Families -->
                <Border Background="#E3F2FD" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#BBDEFB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="IconFamilies" Data="M3,3H21V21H3V3M5,5V19H19V5H5Z" Fill="#1976D2" Width="24" Height="22" Margin="0 0 0 10"/>
                        <Button Content="Rename Families" Background="Transparent" BorderThickness="0" Foreground="#1976D2" FontSize="14" FontWeight="Medium" Cursor="Hand" Command="{Binding OpenRenameFamiliesCommand}"/>
                        <TextBlock  Text="Manage batch renaming of families" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0 5 0 0 " TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Rename Types Family -->
                <Border Background="#E3F2FD" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#BBDEFB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="IconTypesFamily" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z" Fill="#1976D2" Width="24" Height="22" Margin="0 0 0 10"/>
                        <Button Content="Rename Types Family" Background="Transparent" BorderThickness="0" Foreground="#1976D2" FontSize="14" FontWeight="Medium" Cursor="Hand" Command="{Binding OpenRenameTypesFamilyCommand}"/>
                        <TextBlock  Text="Batch rename of Types Family" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0 5 0 0 " TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Rename Views -->
                <Border Background="#E3F2FD" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#BBDEFB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="IconViews" Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z" Fill="#1976D2" Width="24" Height="22" Margin="0 0 0 10"/>
                        <Button Content="Rename Views" Background="Transparent" BorderThickness="0" Foreground="#1976D2" FontSize="14" FontWeight="Medium" Cursor="Hand" Command="{Binding OpenRenameViewsCommand}"/>
                        <TextBlock  Text="Organize and customize view names" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0 5 0 0 " TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Rename Levels -->
                <Border Background="#E3F2FD" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#BBDEFB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="IconLevels" Data="M8.235 1.559a.5.5 0 0 0-.47 0l-7.5 4a.5.5 0 0 0 0 .882L3.188 8 .264 9.559a.5.5 0 0 0 0 .882l7.5 4a.5.5 0 0 0 .47 0l7.5-4a.5.5 0 0 0 0-.882L12.813 8l2.922-1.559a.5.5 0 0 0 0-.882zm3.515 7.008L14.438 10 8 13.433 1.562 10 4.25 8.567l3.515 1.874a.5.5 0 0 0 .47 0zM8 9.433 1.562 6 8 2.567 14.438 6" Fill="#1976D2" Width="24" Height="22" Margin="0 0 0 10"/>
                        <Button Content="Rename Levels" Background="Transparent" BorderThickness="0" Foreground="#1976D2" FontSize="14" FontWeight="Medium" Cursor="Hand" Command="{Binding OpenRenameLevelsCommand}"/>
                        <TextBlock  Text="Modify names of building levels" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0 5 0 0 " TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
