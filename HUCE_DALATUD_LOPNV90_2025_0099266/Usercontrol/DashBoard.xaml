<UserControl x:Class="HUCE_DALATUD_LOPNV90_2025_0099266.Usercontrol.DashBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HUCE_DALATUD_LOPNV90_2025_0099266.Usercontrol" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="250" Background="Transparent">
    <Grid>
        <StackPanel Orientation="Horizontal">

        </StackPanel>
        <Label HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="20">Tỷ Lệ Hoàn Thành</Label>
        <lvc:PieChart LegendLocation="Bottom" Hoverable="False" DataTooltip="{x:Null}" Width="200" Height="200" Margin="0 40 0 0">
            <lvc:PieChart.Series>
                <lvc:PieSeries Title="Rename Succesfull" Values="25" DataLabels="True"
                           LabelPoint="{Binding PointLabel}"/>
                <lvc:PieSeries Title="Errol" Values="3" DataLabels="True" 
                           LabelPoint="{Binding PointLabel}"/>
                <lvc:PieSeries Title="Pending" Values="9" DataLabels="True" 
                           LabelPoint="{Binding PointLabel}"/>
            </lvc:PieChart.Series>
        </lvc:PieChart>
    </Grid>
</UserControl>
